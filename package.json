{

    "name"       : "bootlace",
    "version"    : "1.0.0",
    "description": "Bootlace is a complete reference application integrating a single page AngularJS application with SpringMVC, Spring Security and MongoDB.",
    "main"       : "entry.js",
    "author"     : "Mark Lee <mark.lee@capricasoftware.co.uk> (http://capricasoftware.co.uk/)",

    "license": [{
        "type": "Apache-2.0",
        "url" : "http://www.apache.org/licenses/LICENSE-2.0"
    }],

    "dependencies": {
        "angular"            : "~1.3",
        "angular-animate"    : "~1.3",
        "angular-aria"       : "~1.3",
        "angular-i18n"       : "~1.3",
        "angular-route"      : "~1.3",
        "angular-cache"      : "~4.1",
        "angular-google-maps": "~2.0",
        "angular-toastr"     : "~1.2",
        "blueimp-gallery"    : "~2.15",
        "bootstrap"          : "~3.3",
        "font-awesome"       : "~4.3",
        "jquery"             : "~2.1",
        "lodash"             : "~3.6",
        "moment"             : "~2.11.2",
        "restangular"        : "~1.5"
    },

    "devDependencies": {
        "bootstrap-styl"     : "~4.0",
        "bootswatch"         : "~3.3",
        "browserify"         : "~9.0",
        "browserify-shim"    : "~3.8",
        "cpy"                : "~3.1",
        "cross-env"          : "^7.0.3",
        "font-awesome-stylus": "~4.3",
        "hashmark"           : "~2.0",
        "jade"               : "~1.9",
        "jshint"             : "~2.6",
        "minifyify"          : "~6.4",
        "mkdirp"             : "~0.5",
        "nib"                : "~1.1",
        "nodemon"            : "~1.3",
        "npm-run-all"        : "^4.1.5",
        "parallelshell"      : "~1.1",
        "rimraf"             : "~2.3",
        "stylus"             : "https://github.com/stylus/stylus.git#0.54.5",
        "toastr-stylus"      : "2.0.2-0.1.0"
    },

    "config": {
    },

    "browser": {
        "angular-google-maps": "./node_modules/angular-google-maps/dist/angular-google-maps.min.js",
        "angular-toastr"     : "./node_modules/angular-toastr/dist/angular-toastr.tpls.js",
        "lodash"             : "./node_modules/lodash/index.js",
        "restangular"        : "./node_modules/restangular/dist/restangular.js"
    },
    "browserify-shim": {
        "angular-google-maps": {"exports": "angular.module('uiGmapgoogle-maps')", "depends": ["angular", "lodash:_"]},
        "angular-toastr"     : {"exports": "angular.module('toastr')"           , "depends": "angular"              },
        "restangular"        : {"exports": "angular.module('restangular')"      , "depends": ["angular", "lodash:_"]}
    },
    "browserify" : {
        "transform"          : ["browserify-shim"]
    },

    "scripts": {
        "clean:assets"       : "rimraf target/assets",
        "clean:html"         : "rimraf src/main/resources/static/assets/*.html",
        "clean:js"           : "rimraf src/main/resources/static/assets/*.js",
        "clean:css"          : "rimraf src/main/resources/static/assets/*.css",
        "clean:maps"         : "rimraf src/main/resources/static/assets/*.map",
        "clean"              : "run-s clean:assets clean:html clean:js clean:css clean:maps",

        "mkdir:target"       : "mkdirp target/assets",
        "prebuild"           : "run-s clean mkdir:target",

        "build:scripts"      : "browserify -d src/main/javascript/entry.js | hashmark -n target/assets/index.js -l 8 -m target/assets/assets.json -s src/main/resources/static/assets/{name}-{hash}{ext}",
        "build:styles:compile": "stylus src/main/styles/main.styl --include-css -I node_modules -m -o target/assets",
        "build:styles:hash"   : "hashmark -n assets/main.css -l 8 -m target/assets/assets.json -s target/assets/main.css src/main/resources/static/assets/{name}-{hash}{ext}",
        "build:styles:copy"   : "cpy \"target/assets/*.map\" src/main/resources/static/assets",
        "build:styles"       : "run-s build:styles:compile build:styles:hash build:styles:copy",
        "build:markup"       : "jade -P -o src/main/resources/static/assets src/main/markup/index.jade --obj target/assets/assets.json",

        "build"              : "run-s build:scripts build:styles build:markup",

        "watch"              : "nodemon -q -w src/main/javascript -w src/main/styles -w src/main/markup --ext js,styl,css,jade --exec \"npm run build\"",

        "lint"               : "jshint \"src/main/javascript/**/*.js\""

    }

}
